// use prisma-8

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  hashPassword String
  posts        Post[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model Post {
  id         Int       @id @default(autoincrement())
  title      String
  content    String
  author     String?
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
}
